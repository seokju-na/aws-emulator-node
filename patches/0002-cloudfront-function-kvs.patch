+// A per-invocation snapshot: no host credentials, filesystem or network are exposed.
+const CLOUDFRONT_MODULE: &str = r#"
+export default Object.freeze({
+    kvs(id) {
+        if (snapshot === null) {
+            throw new Error('Function is not associated with a KeyValueStore');
+        }
+        if (id !== undefined && id !== snapshot.id) {
+            throw new Error('KeyValueStore is not associated with this function');
+        }
+        const keys = snapshot.keys;
+        const has = key => Object.prototype.hasOwnProperty.call(keys, key);
+        return Object.freeze({
+            async exists(key) {
+                return has(key);
+            },
+            async get(key, options = {}) {
+                if (!has(key)) {
+                    throw new Error('KeyValueStore key not found: ' + key);
+                }
+                const format = options.format === undefined ? 'string' : options.format;
+                if (format === 'string') {
+                    return keys[key];
+                }
+                if (format === 'json') {
+                    return JSON.parse(keys[key]);
+                }
+                throw new Error('Unsupported KeyValueStore format: ' + format);
+            }
+        });
+    }
+});
+"#;
