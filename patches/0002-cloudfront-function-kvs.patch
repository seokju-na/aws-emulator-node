+#[cfg(test)]
+mod cloudfront_module_tests {
+    use super::*;
+
+    const EVENT: &str = r#"{"request":{"uri":"/index.js"}}"#;
+
+    #[test]
+    fn reads_associated_store_without_exposing_other_modules() {
+        let code = br#"
+            import cf from 'cloudfront';
+            const kvs = cf.kvs('store-id');
+            async function handler(event) {
+                console.log(await kvs.exists('missing'));
+                const config = await kvs.get('config', { format: 'json' });
+                event.request.uri = '/' + config.version + '/' + await kvs.get('file');
+                return event.request;
+            }
+        "#;
+        let snapshot = ::serde_json::json!({"id":"store-id", "keys":{
+            "config":"{\"version\":\"v2\"}", "file":"index.js"
+        }});
+        let result = run(code.to_vec(), EVENT, Some(snapshot));
+        let FunctionOutcome::Returned(output) = result.outcome else {
+            panic!("expected a successful module invocation");
+        };
+        assert_eq!(
+            ::serde_json::from_str::<Json>(&output).unwrap()["request"]["uri"],
+            "/v2/index.js"
+        );
+        assert_eq!(result.logs, vec!["false"]);
+
+        for source in [
+            "import fs from 'node:fs'; function handler(e) { return e.request; }",
+            "import cf from 'cloudfront'; const kvs = cf.kvs(); function handler(e) { return e.request; }",
+        ] {
+            assert!(matches!(
+                run(source.as_bytes().to_vec(), EVENT, None).outcome,
+                FunctionOutcome::Failed(_)
+            ));
+        }
+    }
+
+    #[test]
+    fn missing_keys_fail_and_regular_handlers_still_run() {
+        let snapshot = ::serde_json::json!({"id":"store-id", "keys":{}});
+        let result = run(
+            br#"import cf from 'cloudfront';
+            async function handler(event) { await cf.kvs().get('missing'); return event.request; }
+        "#
+            .to_vec(),
+            EVENT,
+            Some(snapshot),
+        );
+        assert!(
+            matches!(result.outcome, FunctionOutcome::Failed(message) if message.contains("key not found"))
+        );
+        let result = run(
+            b"function handler(event) { return event.request; }".to_vec(),
+            EVENT,
+            None,
+        );
+        assert!(matches!(result.outcome, FunctionOutcome::Returned(_)));
+    }
+}
